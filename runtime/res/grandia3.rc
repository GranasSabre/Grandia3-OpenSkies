// Application resources: icon, manifest (common controls 6, per-monitor DPI awareness)
1 ICON "grandia3.ico"
1 24 "grandia3.manifest"
// update window background (title screen logo), tools/make_updater_art.py
UPDATER_ART 10 "updater.jpg"

#include "../src/version.h"
1 VERSIONINFO
FILEVERSION G3_VERSION_NUM
PRODUCTVERSION G3_VERSION_NUM
FILEOS 0x40004
FILETYPE 1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Grandia III: Open Skies"
      VALUE "ProductName", "Grandia III: Open Skies"
      VALUE "FileVersion", G3_VERSION
      VALUE "ProductVersion", G3_VERSION
      VALUE "OriginalFilename", "Grandia3.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
