#version 450
// Surface maintenance (UTIL_HLSL): surface -> native (top-left sample of each S x S group)
layout(local_size_x = 8, local_size_y = 8) in;
layout(push_constant) uniform U { ivec4 rect; ivec4 info; } u;  // destination x0 y0 x1 y1 (native); scale S
layout(set = 0, binding = 0) uniform usampler2D src;
layout(r32ui, set = 0, binding = 1) uniform writeonly uimage2D dst;
void main() {
    ivec2 p = ivec2(u.rect.x + int(gl_GlobalInvocationID.x), u.rect.y + int(gl_GlobalInvocationID.y));
    if (p.x >= u.rect.z || p.y >= u.rect.w) return;
    imageStore(dst, p, uvec4(texelFetch(src, p * u.info.x, 0).x));
}
