<?xml version="1.0" encoding="utf-8"?>
<!-- Android version: the game is native (NativeActivity, libgrandia3.so); GrandiaActivity adds the
     system file picker for the disc image and messages (runtime/android/java). Landscape; the app's
     data in Android/data/io.github.granassabre.grandia3/files. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.granassabre.grandia3"
    android:versionCode="10801"
    android:versionName="1.0.8-beta1">
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="35" />
    <application
        android:label="Grandia III"
        android:hasCode="true"
        android:extractNativeLibs="true"
        android:debuggable="true"
        android:isGame="true"
        android:appCategory="game"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
        <activity
            android:name=".GrandiaActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density">
            <meta-data android:name="android.app.lib_name" android:value="grandia3" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
